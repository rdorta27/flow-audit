  "license": "MIT",
  "tasks": {
    "check": "deno check src/cli/main.ts src/cli/generate_dataset.ts src/adapters/clock/system_clock.ts src/stub/main.ts tests/",
    "test": "deno test --allow-read",
    "audit": "deno run --allow-read src/cli/main.ts",
    "dataset": "deno run --allow-write src/cli/generate_dataset.ts data/demo",
    "stub": "deno run --allow-read=data/demo --allow-net=127.0.0.1 --allow-env=STUB_PORT,STUB_BEARER_TOKEN src/stub/main.ts"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "exclude": ["docs/**", "README.md", "AGENTS.md", "CHANGELOG.md"]
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
